# FutureEdge Backend Environment Variables Template
# Copy this file to .env and replace the values for your environment.

# Database URL
# For SQLite local development: sqlite:///./futureedge.db
# For PostgreSQL production: postgresql://username:password@hostname:port/dbname?sslmode=require
DATABASE_URL=sqlite:///./futureedge.db

# Security
# Set a strong randomly generated key in production (e.g., openssl rand -hex 32)
JWT_SECRET=supersecretjwtkeythatshouldbechangedinproduction12345!
JWT_ALGORITHM=HS256

# Gemini AI API Key
# Fetch from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# CORS Allowed Origins
# Comma-separated list of frontends allowed to query this API
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment Mode
# Set to 'production' in live server environments
ENVIRONMENT=development
